{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "本次写作程序",
  "description": "写作子智能体的唯一输入。每次运行都必须存在，落在 .blueink/runs/<run_id>/program.json。它只对这一次任务有效——不沉淀成模板，不进化成新规则。",
  "type": "object",
  "required": [
    "run_id", "brand", "category", "communication", "delivery_contract",
    "fact_bounds", "line", "material_plan", "information_budget",
    "expression_bounds", "authorized_reads", "assumptions", "ab"
  ],
  "additionalProperties": true,
  "properties": {
    "run_id": {"type": "string", "description": "所属运行"},
    "brand": {"type": "string", "description": "当前绑定品牌，与 meta.brand 一致"},
    "category": {"type": "string", "description": "品类。它规定必须完成的传播任务，不规定段落顺序"},
    "communication": {
      "type": "object",
      "description": "传播关系与目标",
      "required": ["publisher", "audience", "intent"],
      "properties": {
        "publisher": {"type": "string", "description": "谁在说：品牌官方 / 媒体署名 / 发言人本人"},
        "audience": {"type": "string", "description": "对谁说"},
        "intent": {"type": "string", "description": "希望对方发生什么认知或行动变化"}
      }
    },
    "delivery_contract": {
      "type": "object",
      "description": "场景与交付合同",
      "properties": {
        "occasion": {"type": "string"},
        "channel": {"type": "string"},
        "length": {"type": "string"},
        "format": {"type": "string"},
        "deadline": {"type": "string"}
      }
    },
    "fact_bounds": {
      "type": "object",
      "description": "事实边界。写作者只能用 allowed_fact_ids 里的事实，缺了就申报，不许近似",
      "required": ["allowed_fact_ids"],
      "properties": {
        "allowed_fact_ids": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"},
                      "description": "明确不能写进正文的内容"}
      }
    },
    "line": {"type": "string", "description": "推荐主线：一句可证伪的主张，不是主题词"},
    "material_plan": {
      "type": "object",
      "description": "素材取舍。discarded 里的内容一条都不能出现在正文里",
      "required": ["foreground", "discarded"],
      "properties": {
        "foreground": {"type": "array", "items": {"type": "string"}},
        "background": {"type": "array", "items": {"type": "string"}},
        "discarded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "information_budget": {"type": "string",
      "description": "各部分笔墨分配。是约束，不是段落清单"},
    "expression_bounds": {"type": "array", "items": {"type": "string"},
      "description": "表达边界与客户红线。核验员逐条对照正文"},
    "memories_applied": {
      "type": "array",
      "description": "本次启用的条件化记忆。高置信度可自动进入，但必须在决策卡中可见、可取消",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "knowledge": {"type": "string"},
          "confidence": {"type": "number"},
          "cancellable": {"type": "boolean", "const": true}
        }
      }
    },
    "authorized_reads": {
      "type": "array", "items": {"type": "string"},
      "description": "写作者被允许读取的文件。**审计器 A4 逐项核对写作回执的 read_paths 是否都在这里**——写作阶段重新扫库会让取舍问题与表达问题无法区分"
    },
    "style_refs": {"type": "array", "items": {"type": "string"},
      "description": "风格样本路径。只能是终稿或成品参考，不能是初稿"},
    "assumptions": {"type": "array", "items": {"type": "string"},
      "description": "老师未明确确认、由主智能体裁决的判断。必须显式列出"},
    "ab": {"type": "boolean", "description": "是否生成 A/B 两稿"},
    "ab_variable": {"type": "string",
      "description": "A/B 只在哪一个关键变量上不同：切口 / 信息重心 / 观点层级 / 读者关系"}
  }
}
